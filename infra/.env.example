# Copy to .env to override defaults. All services bind to 127.0.0.1 only.
# POSTGRES_PASSWORD=postgres
# POSTGRES_PORT=5432
# S3_PORT=8333
# SMTP_PORT=1025
# MAILPIT_UI_PORT=8025
# REDIS_PORT=6379
# LOGTO_PORT=3001
# LOGTO_ADMIN_PORT=3002

# If port 80 can't be bound (e.g. rootless Podman), use 8080 and add the port
# to the Logto endpoints so its OIDC issuer matches what the browser sees.
# CADDY_HTTP_PORT=8080
# LOGTO_ENDPOINT=http://logto.localhost:8080
# LOGTO_ADMIN_ENDPOINT=http://logto-admin.localhost:8080
